# Copy this file to .env and fill in real values. Never commit .env.
#   cp .env.example .env

# --- Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=matchflixdb

# --- TMDB ---
# Get a key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# --- Auth ---
# Generate one with:  openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MS=604800000

# --- Recommendation ---
# Salt used to hash user ids before they leave the backend.
# Generate one with:  openssl rand -base64 32
RECO_USER_SALT=

# URL of the Python FastAPI recommendation service.
# Local dev:            http://localhost:8000
# From inside Docker:   http://host.docker.internal:8000
ML_BASE_URL=http://localhost:8000
